# ==========================================
# پروژه 19,20تبدیل گفتار به متن (Speech to Text)

# ==========================================

# ===========================
# ۱. وارد کردن کتابخانه
# ===========================
import speech_recognition as sr

# =====================================================
# ۲. تبدیل فایل صوتی به متن (بارگذاری فایل WAV)
# =====================================================
stt = sr.Recognizer()  # تعریف یک شی که تمام متدها و ابزارهای لازم برای پردازش صدا دارد
seda = sr.AudioFile("seda.wav")  # فایل صوتی را به برنامه معرفی میکنیم ولی هنوز محتوای آن را نخوانده است
with seda as source:  # این خط فایل را باز میکند و اسم seda.wav را سورس میگذارد
    audio = stt.record(source)  # ضبط صدا از فایل
    text = stt.recognize_google(audio, language="fa-IR")  # تشخیص گفتار با گوگل
print(text)  # چاپ فایل صوتی بصورت متن

# =====================================================
# ۳. تبدیل گفتار زنده به متن (با استفاده از میکروفون)
# =====================================================
stt = sr.Recognizer()  # یک شی که تمام متدها و ابزارهای لازم برای پردازش صدا دارد
with sr.Microphone() as source:  # استفاده از میکروفون برای تبدیل صدا به متن
    stt.pause_threshold = 1  # اگر کاربر 1 ثانیه صبر کند و چیزی نگوید درخواست تموم شده و تبدیل به متن میکند
    audio = stt.listen(source)  # این متغیر صدا را از میکروفون دریافت کرده است
text = stt.recognize_google(audio, language='fa-IR')  # صوتی را به سرورهای گوگل می‌فرستد
print(text)  # چاپ متن تشخیص داده شده

# =====================================================
# ۴. تشخیص دستورات روشن و خاموش کردن لامپ (با تطابق دقیق)
# =====================================================
stt = sr.Recognizer()
with sr.Microphone() as source:
    stt.pause_threshold = 1
    audio = stt.listen(source)
text = stt.recognize_google(audio, language='fa-IR')
print(text)
if text == "لامپ روشن":
    print("lamp: ON")
if text == "لامپ خاموش":
    print("lamp: OFF")

# =====================================================
# ۵. تشخیص دستورات لامپ (با شرط وجود کلمه در جمله)
# =====================================================
stt = sr.Recognizer()
with sr.Microphone() as source:
    stt.pause_threshold = 1
    audio = stt.listen(source)
text = stt.recognize_google(audio, language='fa-IR')
print(text)

if "لامپ روشن" in text:
    print("لامپ روشن شو")
if "لامپ خاموش" in text:
    print("لامپ خاموش شو")

# =====================================================
# ۶. ذخیره متن تشخیص داده شده در فایل
# =====================================================
with open("stt.txt", "w", encoding="utf-8") as f:
    f.write(text)
print(text)

from openai import OpenAI

# ===========================
# تنظیمات API
# ===========================
api_key = "w5aac0tBL5Q65CDw6fUQHkQPb5grWTOsEi6Zc4pbPuhDEDsk"
base_url = "https://api.gapgpt.app/v1"

# ===========================
# ایجاد کلاینت OpenAI
# ===========================
client = OpenAI(
    api_key=api_key,
    base_url=base_url
)

# ===========================
# سوال کاربر
# ===========================
soal =text

# ===========================
# ارسال درخواست به API
# ===========================
try:
    response = client.chat.completions.create(
        model="gpt-4o",
        messages=[
            {"role": "user", "content": soal}
        ],
        max_tokens=3000,
        temperature=0.5
    )
    
    # نمایش پاسخ
    javad = response.choices[0].message.content
    print(javad)

except Exception as e:
    print(f"خطایی رخ داد: {e}")
