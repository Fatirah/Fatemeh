rom openai import OpenAI

# ===========================
# تنظیمات API
# ===========================
api_key = "w5aac0tBL5Q65CDw6fUQHkQPb5grWTOsEi6Zc4pbPuhDEDsk"
base_url = "https://api.gapgpt.app/v1"

# ===========================
# ایجاد کلاینت OpenAI
# ===========================
client = OpenAI(
    api_key=api_key,
    base_url=base_url
)

# ===========================
# سوال کاربر
# ===========================
soal = "در مورد مدار منطقی توضیح بده"

# ===========================
# ارسال درخواست به API
# ===========================
try:
    response = client.chat.completions.create(
        model="gpt-4o",
        messages=[
            {"role": "user", "content": soal}
        ],
        max_tokens=3000,
        temperature=0.5
    )
    
    # نمایش پاسخ
    javad = response.choices[0].message.content
    print(javad)

except Exception as e:
    print(f"خطایی رخ داد: {e}")
