# ==========================================
# پروژه تشخیص دیابت با استفاده از Logistic Regression
# ==========================================

# ===========================
# ۱. وارد کردن کتابخانه‌ها
# ===========================
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn import linear_model

# ===========================
# ۲. بارگذاری و بررسی دیتاست
# ===========================
df = pd.read_csv('diabetes.csv')
df
df.describe()
df.head()
df.tail()

# ===========================
# ۳. جدا کردن ویژگی‌ها و هدف
# ===========================
x = df.drop("Outcome", axis=1)  # ویژگی‌ها (ورودی)
x
x.shape

y = df.Outcome  # هدف (خروجی)
y

# ===========================
# ۴. تقسیم داده‌ها به آموزش و تست
# ===========================
X_train, X_test, y_train, y_test = train_test_split(x, y, test_size=0.2)

# ===========================
# ۵. ساخت و آموزش مدل
# ===========================
model = linear_model.LogisticRegression()
model.fit(X_train, y_train)

# ===========================
# ۶. پیش‌بینی روی داده‌های تست
# ===========================
out_robot = model.predict(X_test)
out_robot
y_test

# ===========================
# ۷. محاسبه خطا و دقت
# ===========================
error = out_robot - y_test

sahih = 0
qalat = 0
for a in error:
    if (a == 0):
        sahih = sahih + 1
    if (a != 0):
        qalat = qalat + 1

print("sahih:", sahih)
print("qalat:", qalat)

# ===========================
# ۸. تست مدل روی یک نمونه جدید
# ===========================
fatemehx = np.array([[0, 180, 120, 20, 90, 38, 0, 19]])
fatemeh = model.predict(fatemehx)
print(fatemeh)
