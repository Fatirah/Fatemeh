import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn import linear_model
import sklearn.metrics as sm
from sklearn.model_selection import train_test_split
from sklearn import datasets

digits = datasets.load_digits()

digits.data
digits.images
digits.data.shape
digits.images.shape
digits.target
digits.target[1200]

plt.imshow(digits.images[1200])
plt.show()

x = digits.data
y = digits.target

X_train, X_test, y_train, y_test = train_test_split(x, y, test_size=0.2)

model = linear_model.LogisticRegression()
model.fit(X_train, y_train)

out_robot = model.predict(X_test)

out_robot
y_test
X_test.shape
X_train.shape

error = out_robot - y_test
print(error)

sahih = 0
ghalat = 0
for a in error:
    if a == 0:
        sahih += 1
    if a != 0:
        ghalat += 1
print(sahih)
print(ghalat)

darsad_sahih = (sahih * 100) / 360
print(str(darsad_sahih) + "%")

