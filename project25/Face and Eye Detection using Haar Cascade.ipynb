# ==========================================
# پروژه تشخیص چهره و چشم با استفاده از Haar Cascade
 ==========================================

# ===========================
# ۱. وارد کردن کتابخانه‌ها
# ===========================
import cv2
import matplotlib.pyplot as plt

# =====================================================
# ۲. بارگذاری تصویر و بررسی ابعاد
# =====================================================
img = cv2.imread('img1.jpg')
print(img.shape)  # نمایش ابعاد تصویر

# =====================================================
# ۳. تعریف تابع برای نمایش تصویر
# =====================================================
def ishow(image):
    cv2.imshow('image', image)  # نمایش تصویر در پنجره جداگانه
    cv2.waitKey(0)  # منتظر فشردن کلید
    cv2.destroyAllWindows()  # بستن پنجره

# =====================================================
# ۴. دریافت تصویر از وب‌کم
# =====================================================
cam = cv2.VideoCapture(0)  # باز کردن وب‌کم
_, img_webcam = cam.read()  # خواندن یک فریم از وب‌کم
ishow(img_webcam)  # نمایش تصویر وب‌کم

# =====================================================
# ۵. نمایش تصویر اصلی
# =====================================================
ishow(img)  # نمایش تصویر اصلی

# =====================================================
# ۶. بارگذاری مدل تشخیص چهره (Haar Cascade)
# =====================================================
face_model = cv2.CascadeClassifier("haarcascade_frontalface_default.xml")

# =====================================================
# ۷. تبدیل تصویر به خاکستری و تشخیص چهره
# =====================================================
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)  # تبدیل به خاکستری
ishow(gray)  # نمایش تصویر خاکستری

face = face_model.detectMultiScale(gray)  # تشخیص چهره
print(face)  # نمایش مختصات چهره‌ها

# =====================================================
# ۸. نمایش تصویر خاکستری با matplotlib
# =====================================================
plt.imshow(gray)  # نمایش تصویر خاکستری در matplotlib
plt.show()

# =====================================================
# ۹. رسم مستطیل تستی روی تصویر خاکستری
# =====================================================
out1 = cv2.rectangle(gray, (100, 100), (200, 200), (250, 0, 250), 3)
ishow(out1)

# =====================================================
# ۱۰. استخراج مختصات چهره
# =====================================================
print(face[0])  # نمایش مختصات اولین چهره
print(face[0][0])  # x
print(face[0][1])  # y

x = face[0][0]  # مختصات x گوشه سمت چپ بالا
y = face[0][1]  # مختصات y گوشه سمت چپ بالا
x2 = x + face[0][2]  # عرض چهره
y2 = y + face[0][3]  # ارتفاع چهره

# =====================================================
# ۱۱. رسم مستطیل دور چهره روی تصویر اصلی
# =====================================================
out1 = cv2.rectangle(img, (x, y), (x2, y2), (250, 0, 250), 3)
ishow(out1)

# =====================================================
# ۱۲. کپی تصویر و رسم مستطیل دور چهره
# =====================================================
img2 = img.copy()  # کپی از تصویر اصلی
out1 = cv2.rectangle(img2, (x, y), (x2, y2), (250, 0, 250), 3)
ishow(img2)

# =====================================================
# ۱۳. بارگذاری مدل تشخیص چشم (Haar Cascade)
# =====================================================
eye_model = cv2.CascadeClassifier("haarcascade_eye.xml")

# =====================================================
# ۱۴. تشخیص چشم‌ها
# =====================================================
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)  # تبدیل به خاکستری
eye = eye_model.detectMultiScale(gray)  # تشخیص چشم‌ها
print(eye)  # نمایش مختصات چشم‌ها

# =====================================================
# ۱۵. استخراج مختصات چشم اول
# =====================================================
print(eye[0])
print(eye[0][0])  # x
print(eye[0][1])  # y

x = eye[0][0]
y = eye[0][1]
x2 = x + eye[0][2]
y2 = y + eye[0][3]

# =====================================================
# ۱۶. رسم مستطیل دور چشم اول
# =====================================================
img2 = img.copy()
out1 = cv2.rectangle(img2, (x, y), (x2, y2), (0, 250, 0), 3)
ishow(img2)

# =====================================================
# ۱۷. استخراج مختصات چشم دوم
# =====================================================
xb = eye[1][0]
yb = eye[1][1]
x2b = xb + eye[1][2]
y2b = yb + eye[1][3]

# =====================================================
# ۱۸. استخراج مختصات چهره (دوباره)
# =====================================================
xs = face[0][0]
ys = face[0][1]
x2s = xs + face[0][2]
y2s = ys + face[0][3]

# =====================================================
# ۱۹. رسم مستطیل دور چهره، چشم چپ و چشم راست
# =====================================================
img2 = img.copy()
out1 = cv2.rectangle(img2, (x, y), (x2, y2), (250, 0, 0), 3)      # چشم چپ (آبی)
out1 = cv2.rectangle(img2, (xb, yb), (x2b, y2b), (0, 0, 250), 3)  # چشم راست (قرمز)
out1 = cv2.rectangle(img2, (xs, ys), (x2s, y2s), (250, 0, 250), 3) # چهره (بنفش)
ishow(out1)  # نمایش تصویر نهایی
