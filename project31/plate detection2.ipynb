# ==========================================
# پروژه تشخیص پلاک خودرو با استفاده از پردازش تصویر و Logistic Regression
# ==========================================

# ===========================
# ۱. وارد کردن کتابخانه‌ها
# ===========================
import numpy as np            
import os            
import cv2
from sklearn.model_selection import train_test_split 
from sklearn import linear_model 
import matplotlib.pyplot as plt

# =====================================================
# ۲. تعریف تابع برای بارگذاری و تبدیل تصویر به بردار
# =====================================================
def loadflattenimage(imageadd):
    img = cv2.imread(imageadd)
    base_size_x = 8
    base_size_y = 32
    base_size = base_size_x * base_size_y
    boxes = np.empty((0, 4), dtype=int)
    plak_name = "plak.png"
    # ستون اسم معنی
    # x فاصله از لبه چپ عکس (چند پیکسل)
    # y فاصله از لبه بالای عکس (چند پیکسل)
    # width عرض کاراکتر (چند پیکسل)
    # height ارتفاع کاراکتر (چند پیکسل)
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    resized = cv2.resize(gray, (base_size_x, base_size_y))
    flatted = resized.flatten()
    return flatted

# =====================================================
# ۳. ساخت دیتاست از تصاویر کاراکترها
# =====================================================
base_size_x = 8
base_size_y = 32
base_size = base_size_x * base_size_y

ds_images = np.empty((0, base_size), dtype=int)
ds_nos = np.empty((0,), dtype=int)

for dirno in range(1, 10):
    files = os.listdir("dataset/" + str(dirno))
    for filename in files: 
        im = loadflattenimage("dataset/" + str(dirno) + "/" + filename) 
        ds_images = np.append(ds_images, [im], axis=0)
        ds_nos = np.append(ds_nos, dirno)

# =====================================================
# ۴. تقسیم داده‌ها و آموزش مدل
# =====================================================
X_train, X_test, y_train, y_test = train_test_split(ds_images, ds_nos, test_size=0.2)
model = linear_model.LogisticRegression()
model.max_iter = 100000
model.fit(ds_images, ds_nos)
out = model.predict(X_test)

# =====================================================
# ۵. بارگذاری و پردازش تصویر پلاک
# =====================================================
pelak_base = cv2.imread("pelak.png")
pelak_base = cv2.resize(pelak_base, (410, 90))
pelak = pelak_base.copy()
pelak = cv2.cvtColor(pelak, cv2.COLOR_BGR2GRAY)
_, pelak = cv2.threshold(pelak, 64, 255, cv2.THRESH_BINARY)
plot = 90 - np.sum(pelak, axis=0, keepdims=True) / 255
plt.plot(plot[0])

# =====================================================
# ۶. پردازش پیشرفته پلاک و تشخیص کاراکترها
# =====================================================
pelak_name = "pelak.png"
pelak_base = cv2.imread(pelak_name)
pelak_base = cv2.resize(pelak_base, (410, 90))
pelak = pelak_base.copy()
pelak = cv2.cvtColor(pelak, cv2.COLOR_BGR2GRAY)
pelak = cv2.blur(pelak, (3, 3))
_, pelak = cv2.threshold(pelak, 64, 255, cv2.THRESH_BINARY)
pelak = cv2.blur(pelak, (3, 3))
plot = 90 - np.sum(pelak, axis=0, keepdims=True) / 255

# =====================================================
# ۷. تشخیص کاراکترها با استفاده از پروفایل ستونی
# =====================================================
linethreshold = 5
min_width = 15
max_width = 50
start_index = 0
end_index = 0
prev_value = 0
final_number = ""

for index, plot_value in enumerate(plot[0]):
    if (plot_value >= linethreshold and prev_value < linethreshold):
        start_index = index

    if (plot_value < linethreshold and prev_value >= linethreshold):
        width = index - start_index
        if (width > max_width):
            final_number = final_number + " "
        if (width > min_width and width < max_width):
            end_index = index
            cv2.rectangle(pelak, (start_index, 0), (end_index, 89), (0, 0, 255), 1)
            new_pic = pelak[:, start_index:end_index]
            new_piccolor = pelak_base[:, start_index:end_index]
            new_picf = cv2.resize(new_pic, (base_size_x, base_size_y)).flatten()
            out = model.predict([new_picf])
            print(out[0], end="")
            final_number = final_number + str(out[0])
            
            cv2.imshow('pelak', new_piccolor)
            cv2.waitKey(0)
            cv2.destroyAllWindows()

    prev_value = plot_value

# =====================================================
# ۸. نمایش نتیجه نهایی روی پلاک
# =====================================================
zipepelak = pelak_base[0:50].copy()
np.ndarray.fill(zipepelak[0:50], 255)
pelak_base = np.append(pelak_base, zipepelak, axis=0)
cv2.putText(pelak_base, "Pelak : " + final_number, (10, 100), cv2.FONT_HERSHEY_SIMPLEX, 0.75, (255, 0, 255), 1, cv2.LINE_AA)

print()
print(str(final_number))

cv2.imshow('Pelak', pelak_base)
cv2.waitKey(0)
cv2.imshow('Pelak', pelak)
cv2.waitKey(0)
cv2.destroyAllWindows()
