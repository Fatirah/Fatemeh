# ==========================================
# پروژه 28: تشخیص چهره با استفاده از face_recognition
 ==========================================

# ===========================
# ۱. وارد کردن کتابخانه‌ها
# ===========================
import face_recognition as fr
import cv2
import dlib
import numpy

# =====================================================
# ۲. بارگذاری تصویر و تشخیص موقعیت چهره
# =====================================================
image = fr.load_image_file('img1.bmp')
locate = fr.face_locations(image)
print(locate)          # مختصات چهره
print(locate[0])       # مختصات اولین چهره

# =====================================================
# ۳. نمایش تصویر اصلی با OpenCV (BGR)
# =====================================================
cv2.imshow('image', image)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۴. تبدیل BGR به RGB برای نمایش صحیح رنگ‌ها
# =====================================================
image2 = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
cv2.imshow('image', image2)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۵. تغییر اندازه تصویر و نمایش (کامنت شده)
# =====================================================
# image2 = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
# image2 = cv2.resize(image2, (512, 340))
# cv2.imshow('image', image2)
# cv2.waitKey(0)
# cv2.destroyAllWindows()

# =====================================================
# ۶. رسم مستطیل دور چهره (نسخه اول - با خطا)
# =====================================================
image2 = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
image2 = cv2.rectangle(image, (locate[0][3], locate[0][0]), (locate[0][1], locate[0][2]), (255, 0, 0), 2)
cv2.imshow('image', image2)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۷. رسم مستطیل دور چهره (نسخه دوم - صحیح)
# =====================================================
image2 = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
image2 = cv2.rectangle(image2, (locate[0][3], locate[0][0]), (locate[0][1], locate[0][2]), (255, 0, 0), 2)
cv2.imshow('image', image2)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۸. استخراج ویژگی‌های چهره (Face Encoding)
# =====================================================
sabt_sorat = fr.face_encodings(image)[0]  # آرایه 128 عنصری
print(sabt_sorat)

# =====================================================
# ۹. بارگذاری تصویر تست و تشخیص چهره
# =====================================================
imagetest = fr.load_image_file('img2.bmp')
cv2.imshow('image', imagetest)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۱۰. استخراج ویژگی‌های چهره تست و مقایسه
# =====================================================
imagetest_encode = fr.face_encodings(imagetest)[0]
result = fr.compare_faces([sabt_sorat], imagetest_encode)
print(result)  # [True] یا [False]
