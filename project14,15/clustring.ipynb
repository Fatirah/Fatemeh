# tamrin clustring.ipynb

from sklearn import datasets 
from sklearn.cluster import KMeans 
import matplotlib.pyplot as plt     

digits=datasets.load_digits()

x=digits.data

model=KMeans(n_clusters=4,random_state=0)

model.fit(x)

num=int(input())

sample=x[digits.target==num][0]

out_robot=model.predict([sample])[0]
print("cluster" + str(out_robot))

plt.imshow(sample.reshape(8,8),cmap='cool')
plt.show()
