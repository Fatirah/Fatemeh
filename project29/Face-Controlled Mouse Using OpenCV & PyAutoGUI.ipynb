
#پروژه29
# ===========================
# ۱. وارد کردن کتابخانه‌ها
# ===========================
import cv2
import pyautogui as robot
import numpy as np

# ===========================
# ۲. بارگذاری مدل‌های Haar Cascade
# ===========================
face_model = cv2.CascadeClassifier("haarcascade_frontalface_default.xml")
eye_model = cv2.CascadeClassifier("haarcascade_eye.xml")

# ===========================
# ۳. باز کردن وب‌کم
# ===========================
cam = cv2.VideoCapture(0)

# ===========================
# ۴. حلقه اصلی برنامه (ردیابی چهره و حرکت موس)
# ===========================
loop = True
while loop:
    _, img = cam.read()
    img = cv2.flip(img, 1)  # آینه‌ای کردن تصویر
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    face = face_model.detectMultiScale(gray)
    imgout = img.copy()
    
    if len(face) > 0:
        x = face[0][0]
        y = face[0][1]
        x2 = x + face[0][2]
        y2 = y + face[0][3]
        
        # برش ناحیه چهره برای تشخیص چشم
        gray_face = gray[y:y2, x:x2]
        eye = eye_model.detectMultiScale(gray_face)
        
        # رسم مستطیل دور چهره (سبز)
        cv2.rectangle(imgout, (x, y), (x2, y2), (0, 255, 0), 3)
        
        # رسم مستطیل دور چشم‌ها (قرمز)
        if len(eye) >= 2:
            xe = eye[0][0]
            ye = eye[0][1]
            x2e = xe + eye[0][2]
            y2e = ye + eye[0][3]
            
            xbe = eye[1][0]
            ybe = eye[1][1]
            x2be = xbe + eye[1][2]
            y2be = ybe + eye[1][3]
            
            cv2.rectangle(imgout, (x + xe, y + ye), (x + x2e, y + y2e), (0, 0, 250), 3)
            cv2.rectangle(imgout, (x + xbe, y + ybe), (x + x2be, y + y2be), (0, 0, 250), 3)
        
        # =============================================
        # بخش حرکت موس با ردیابی چهره
        # =============================================
        white = (250, 250, 250)
        blue = (255, 0, 0)
        rang = white
        
        # دریافت موقعیت فعلی موس
        mouse_x = robot.position().x
        mouse_y = robot.position().y
        
        # حرکت موس بر اساس موقعیت چهره
        if x < 200:
            rang = blue
            mouse_x = mouse_x - abs(x - 200)
            robot.moveTo(mouse_x, mouse_y, 0)
        
        if x2 > 450:
            rang = blue
            mouse_x = mouse_x + abs(x2 - 450)
            robot.moveTo(mouse_x, mouse_y, 0)
        
        if y < 80:
            rang = blue
            mouse_y = mouse_y - abs(y - 80)
            robot.moveTo(mouse_x, mouse_y, 0)
        
        if y2 > 350:
            rang = blue
            mouse_y = mouse_y + abs(y2 - 350)
            robot.moveTo(mouse_x, mouse_y, 0)
        
        # رسم مستطیل ناحیه فعال (برای حرکت موس)
        cv2.rectangle(imgout, (200, 80), (450, 350), rang, 3)
        
        # چاپ مختصات چهره در کنسول
        print("x: ", x, " y: ", y)
    
    # نمایش تصویر خروجی
    cv2.imshow('fatemeh', imgout)
    
    # خروج با کلید 'q'
    if cv2.waitKey(1) == ord('q'):
        loop = False
        cv2.destroyAllWindows()
        cam.release()
        break
