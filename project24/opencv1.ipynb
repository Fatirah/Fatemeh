# ==========================================
# پروژه 24: پردازش تصویر با OpenCV و ابزارهای هوش مصنوعی ==========================================

# ===========================
# ۱. وارد کردن کتابخانه‌ها
# ===========================
import cv2
import matplotlib.pyplot as plt

# =====================================================
# ۲. بارگذاری و بررسی تصویر
# =====================================================
img = cv2.imread('1.jpg')  # بارگذاری تصویر
print(img.shape)  # نمایش ابعاد تصویر (ارتفاع, عرض, تعداد کانال‌ها)
print(img.ndim)   # نمایش تعداد ابعاد (3 = RGB)

# =====================================================
# ۳. نمایش تصویر با matplotlib (رنگ‌ها نادرست است)
# =====================================================
plt.imshow(img)  # نمایش تصویر (رنگ‌ها به دلیل BGR بودن اشتباه است)
plt.show()

# =====================================================
# ۴. تبدیل BGR به RGB برای نمایش صحیح رنگ‌ها
# =====================================================
img2 = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)  # تبدیل BGR به RGB
plt.imshow(img2)  # نمایش تصویر با رنگ‌های صحیح
plt.show()

# =====================================================
# ۵. برش تصویر (Cropping)
# =====================================================
img_cr = img2[250:750, 250:750]  # برش تصویر از سطر 250 تا 750 و ستون 250 تا 750
plt.imshow(img_cr)  # نمایش تصویر برش خورده
plt.show()
print(img_cr.shape)  # نمایش ابعاد تصویر برش خورده

# =====================================================
# ۶. تغییر اندازه تصویر (Resize)
# =====================================================
size = (100, 100)  # اندازه جدید
img_resize = cv2.resize(img_cr, size, cv2.INTER_AREA)  # تغییر اندازه با روش INTER_AREA
plt.imshow(img_resize)  # نمایش تصویر تغییر اندازه داده شده
plt.show()

# =====================================================
# ۷. تبدیل تصویر به خاکستری (Grayscale)
# =====================================================
img_gray = cv2.cvtColor(img2, cv2.COLOR_RGB2GRAY)  # تبدیل به خاکستری
plt.imshow(img_gray)  # نمایش با matplotlib (رنگ‌ها نادرست است)
plt.show()

# =====================================================
# ۸. نمایش تصویر خاکستری با OpenCV (پنجره جداگانه)
# =====================================================
cv2.imshow('ax1', img_gray)  # نمایش تصویر خاکستری در پنجره OpenCV
cv2.waitKey(0)  # منتظر فشردن کلید
cv2.destroyAllWindows()  # بستن پنجره

# =====================================================
# ۹. آستانه‌گذاری (Thresholding)
# =====================================================
_, img_tr = cv2.threshold(img_gray, 150, 255, cv2.THRESH_BINARY)
# پارامترها: تصویر خاکستری، آستانه 150، مقدار ماکزیمم 255، نوع آستانه باینری
# پیکسل‌های > 150 → 255 (سفید) و پیکسل‌های < 150 → 0 (سیاه)

cv2.imshow('ax1', img_tr)  # نمایش تصویر آستانه‌گذاری شده
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۱۰. نوشتن متن روی تصویر
# =====================================================
img = cv2.putText(img, "Hello", (100, 100), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)
# پارامترها: تصویر، متن، موقعیت (x,y)، نوع فونت، اندازه، رنگ (RGB)، ضخامت

# =====================================================
# ۱۱. رسم مستطیل روی تصویر
# =====================================================
img = cv2.rectangle(img, (200, 400), (800, 650), (0, 0, 255), 2)
# پارامترها: تصویر، نقطه شروع، نقطه پایان، رنگ، ضخامت

# =====================================================
# ۱۲. ذخیره تصویر نهایی
# =====================================================
cv2.imwrite('Image.jpg', img)  # ذخیره تصویر با نام Image.jpg

# =====================================================
# ۱۳. نمایش تصویر نهایی با OpenCV
# =====================================================
cv2.imshow('ax1', img)  # نمایش تصویر نهایی
cv2.waitKey(0)
cv2.destroyAllWindows()
