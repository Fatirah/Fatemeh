import pyttsx3 as tts
engine = tts.init()
voices = engine.getProperty('voices')  # دریافت لیست صداهای موجود
engine.setProperty('voice', voices[1].id)  # انتخاب صدای دوم (معمولاً زنانه)
engine.setProperty('rate', 125)  # تنظیم سرعت گفتار
engine.say("im a computer engineer")
engine.runAndWait()
from deep_translator import GoogleTranslator
import speech_recognition as sr

stt = sr.Recognizer()  # تعریف شی برای تشخیص گفتار
with sr.Microphone() as source:  # استفاده از میکروفون
    stt.pause_threshold = 1  # تنظیم زمان مکث برای تشخیص گفتار
    audio = stt.listen(source)  # دریافت صدا از میکروفون
text = stt.recognize_google(audio, language='fa-IR')  # تشخیص گفتار به فارسی
print("")

# ترجمه متن تشخیص داده شده به انگلیسی
en = GoogleTranslator(source="auto", target="en").translate(text)
print("")
print("")
print("persian:", text)
print("english:", en)

# تبدیل متن ترجمه شده به گفتار
engine = tts.init()
engine.say(en)
engine.runAndWait()
