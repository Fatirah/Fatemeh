# ==========================================
# پروژه تشخیص و پردازش پلاک خودرو (Plate Detection)
# ==========================================

# ===========================
# ۱. وارد کردن کتابخانه‌ها
# ===========================
import cv2
import os
import numpy as np

# =====================================================
# ۲. بارگذاری و نمایش تصویر
# =====================================================
im = cv2.imread('1/1 (1).jpg')
cv2.imshow('ax', im)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۳. لیست کردن فایل‌های پوشه اول
# =====================================================
files = os.listdir('1')
print(files)  # نمایش لیست فایل‌ها
files[0]  # اولین فایل

# =====================================================
# ۴. تغییر اندازه تصویر (نرمالایز کردن)
# =====================================================
im2 = cv2.resize(im, (8, 32))  # تغییر اندازه به 8×32
im.shape  # نمایش ابعاد تصویر اصلی
cv2.imshow('ax', im)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۵. تبدیل به بردار یک‌بعدی و برگشت به شکل اولیه
# =====================================================
im4 = im3.flatten()  # تبدیل به بردار یک‌بعدی
im5 = im4.reshape(32, 8)  # برگشت به شکل 32×8

# =====================================================
# ۶. ساخت دیتاست (روش اول - اشتباه)
# =====================================================
x = np.array([])
for filename in files:
    im = cv2.imread('1/' + filename)
    im2 = cv2.resize(im, (8, 32))
    im3 = cv2.cvtColor(im2, cv2.COLOR_BGR2GRAY)
    im4 = im3.flatten()
    x = np.append(x, im4)
x.shape  # 350*256 (اشتباه)

# =====================================================
# ۷. ساخت دیتاست (روش دوم - صحیح با axis=0)
# =====================================================
x = np.empty((0, 256))  # ماتریس خالی برای ویژگی‌ها
for filename in files:
    im = cv2.imread('1/' + filename)
    im2 = cv2.resize(im, (8, 32))
    im3 = cv2.cvtColor(im2, cv2.COLOR_BGR2GRAY)
    im4 = im3.flatten()
    x = np.append(x, [im4], axis=0)  # اضافه کردن به عنوان سطر
x.shape

# =====================================================
# ۸. ساخت دیتاست کامل با برچسب‌ها (پوشه ۱ و ۲)
# =====================================================
x = np.empty((0, 256))
y = np.array([])

# پوشه ۱ (برچسب 1)
for filename in files:
    im = cv2.imread('1/' + filename)
    im2 = cv2.resize(im, (8, 32))
    im3 = cv2.cvtColor(im2, cv2.COLOR_BGR2GRAY)
    im4 = im3.flatten()
    x = np.append(x, [im4], axis=0)
    y = np.append(y, 1)

# پوشه ۲ (برچسب 2)
files = os.listdir('2')
for filename in files:
    im = cv2.imread('2/' + filename)
    im2 = cv2.resize(im, (8, 32))
    im3 = cv2.cvtColor(im2, cv2.COLOR_BGR2GRAY)
    im4 = im3.flatten()
    x = np.append(x, [im4], axis=0)
    y = np.append(y, 2)

# =====================================================
# ۹. تقسیم داده‌ها و آموزش مدل
# =====================================================
from sklearn import linear_model
from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(x, y, test_size=0.2)

model = linear_model.LogisticRegression()
model.fit(X_train, y_train)

# =====================================================
# ۱۰. تست مدل روی یک تصویر جدید
# =====================================================
x1 = np.empty((0, 256))
im = cv2.imread('1/1 (153).jpg')
im2 = cv2.resize(im, (8, 32))
im3 = cv2.cvtColor(im2, cv2.COLOR_BGR2GRAY)
im4 = im3.flatten()
x1 = np.append(x1, [im4], axis=0)

natejeh = model.predict(x1)
print(natejeh)  # خروجی پیش‌بینی مدل
