# ---------------------------------------------------------
# پروژه 27:پردازش صدا
# ---------------------------------------------------------

# 1. ایمپورت کتابخانه‌های مورد نیاز
import pyaudio
import numpy as np
import matplotlib.pyplot as plt

# تنظیم اندازه بافر (تعداد فریم‌های ضبط شده در هر بار)
sabad = 1024

# ---------------------------------------------------------
# بخش 1: ضبط و ذخیره‌سازی صدا (فرمت 16 بیتی)
# ---------------------------------------------------------

# ایجاد شیء PyAudio برای مدیریت سخت‌افزار صدا
p = pyaudio.PyAudio()

# باز کردن استریم ورودی (ضبط صدا از میکروفون)
# فرمت: 16 بیت (pyaudio.paInt16)، تک کانال، نرخ نمونه‌برداری 16000 هرتز
stream = p.open(format=pyaudio.paInt16, channels=1, rate=16000, input=True, frames_per_buffer=sabad)

# خواندن داده‌های خام صدا از بافر و چاپ نوع آن‌ها (داده‌های باینری)
a = stream.read(sabad)
print(a) 

# تبدیل داده‌های باینری (رشته) به آرایه اعداد صحیح 16 بیتی جهت پردازش
# نکته: توابع `fromstring` و `tostring` قدیمی هستند، اما در ویدیو از آن‌ها استفاده شده است
data = np.fromstring(a, dtype=np.int16)

# نمایش مقادیر عددی تبدیل شده
print(data)

# رسم نمودار موج صدا برای 1024 داده اول
plt.plot(data)
plt.show()

# ---------------------------------------------------------
# بخش 2: ضبط صدای بلندتر با استفاده از حلقه (5 ثانیه)
# ---------------------------------------------------------

# ایجاد آرایه خالی برای ذخیره کل صدای ضبط شده
data2 = np.array([])

# حلقه برای ضبط 50 بار داده (هر بار 1024 فریم → حدود 5 ثانیه صدا)
for i in range(0, 50):
    a = stream.read(sabad)
    # تبدیل داده‌های جدید به آرایه و الصاق به آرایه اصلی
    data2 = np.append(data2, np.fromstring(a, dtype=np.int16))

# توقف استریم، بستن آن و خاتمه دادن به شیء PyAudio
stream.stop_stream()
stream.close()
p.terminate()

# چاپ ابعاد آرایه صوتی ضبط شده (حدود 51200 داده)
print(data2)
print(data2.shape)

# بررسی و چاپ اطلاعات آماری صدا (بیشینه و میانگین)
# مشاهده می‌شود که دامنه صدا بالاست (مثلاً حدود 4600)
print(data2.max())
print(data2.mean())

# ---------------------------------------------------------
# بخش 3: پخش صدای ضبط شده (ذخیره در حافظه و پخش)
# ---------------------------------------------------------

# ایجاد استریم خروجی برای پخش صدا (همان تنظیمات ورودی)
out = pyaudio.PyAudio().open(format=pyaudio.paInt16, channels=1, rate=16000, output=True, frames_per_buffer=sabad)

# تبدیل داده‌ها به باینری آماده برای پخش
# (در ویدیو به دلیل قدیمی بودن کتابخانه خطا نمایش داده می‌شود اما کار می‌کند)
data_out = np.chararray.tostring(data2.astype(np.int16))

# نوشتن و پخش صدا (مشاهده می‌شود صدای ضبط شده پخش می‌شود)
out.write(data_out)

# ---------------------------------------------------------
# بخش 4: کاهش نویز و هموارسازی صدا
# ---------------------------------------------------------

# محاسبه زمان ضبط: 51200 داده / 16000 نرخ نمونه = 3.2 ثانیه (در ویدیو 5 ثانیه گفته شده)
# 1024 / 16000 = 0.064 ثانیه برای هر بافر
# 50 * 0.064 = 3.2 ثانیه

# 1. کاهش دامنه صدا به نصف (کاهش حجم صدا)
data2 = data2 / 2
plt.plot(data2)
plt.show()

# 2. حذف بخش‌های اولیه و انتهایی صدا (بی‌صداها)
data2 = data2[2000:8000]
plt.plot(data2)
plt.show()

# 3. حذف نویزهای کم‌دامنه (نویز پس‌زمینه)
# اگر مقدار صدا کمتر از 200 باشد، آن را صفر می‌کنیم (آستانه حذف نویز)
for x in range(0, 11200): # طول آرایه در اینجا حدود 11200 است
    if data2[x] < 200 and data2[x] > -200:
        data2[x] = 0

# نمایش آرایه پس از حذف نویز
plt.plot(data2)
plt.show()

# ---------------------------------------------------------
# بخش 5: تحلیل سیگنال (FFT و اسپکتروگرام)
# ---------------------------------------------------------

# اسپکتروگرام: نمایش فرکانس‌های صدا در طول زمان
# (رنگ‌های روشن‌تر نشان‌دهنده فرکانس‌های قوی‌تر هستند)
plt.specgram(data2, Fs=16000)
plt.show()

# تبدیل فوریه سریع (FFT): تبدیل سیگنال از حوزه زمان به حوزه فرکانس
out_fft = np.fft.fft(data2)

# رسم نمودار FFT (مقادیر فرکانسی صدا)
plt.plot(out_fft)
plt.show()
