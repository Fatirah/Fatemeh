# ==========================================
# پروژه تشخیص چهره و چشم با استفاده از Haar Cascade (نسخه ویدئو و وب‌کم) ==========================================

# ===========================
# ۱. وارد کردن کتابخانه
# ===========================
import cv2

# =====================================================
# ۲. تعریف تابع نمایش تصویر
# =====================================================
def ishow(image):
    cv2.imshow('image', image)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

# =====================================================
# ۳. بارگذاری مدل‌های Haar Cascade
# =====================================================
face_model = cv2.CascadeClassifier("haarcascade_frontalface_default.xml")
eye_model = cv2.CascadeClassifier("haarcascade_eye.xml")

# =====================================================
# ۴. باز کردن وب‌کم
# =====================================================
cam = cv2.VideoCapture(0)

# =====================================================
# ۵. تشخیص چهره روی یک فریم ثابت از وب‌کم
# =====================================================
_, img = cam.read()
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
face = face_model.detectMultiScale(gray)
imgout = img.copy()

x = face[0][0]
y = face[0][1]
x2 = x + face[0][2]
y2 = y + face[0][3]

out = cv2.rectangle(imgout, (x, y), (x2, y2), (0, 255, 0), 3)
cv2.imshow('fatemeh', out)
cv2.waitKey(0)
cv2.destroyAllWindows()

# =====================================================
# ۶. تشخیص چهره در حلقه while (نسخه اول - با waitKey(0))
# =====================================================
loop = True
while loop:
    _, img = cam.read()
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    face = face_model.detectMultiScale(gray)
    imgout = img.copy()

    x = face[0][0]
    y = face[0][1]
    x2 = x + face[0][2]
    y2 = y + face[0][3]

    out = cv2.rectangle(imgout, (x, y), (x2, y2), (0, 255, 0), 3)
    cv2.imshow('fateme', out)

    if cv2.waitKey(0) == ord('q'):
        loop = False
        cv2.destroyAllWindows()
        break

# =====================================================
# ۷. تشخیص چهره در حلقه while (نسخه دوم - با waitKey(1))
# =====================================================
loop = True
while loop:
    _, img = cam.read()
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    face = face_model.detectMultiScale(gray)
    imgout = img.copy()

    x = face[0][0]
    y = face[0][1]
    x2 = x + face[0][2]
    y2 = y + face[0][3]

    out = cv2.rectangle(imgout, (x, y), (x2, y2), (0, 255, 0), 3)
    cv2.imshow('fatemeh', out)

    if cv2.waitKey(1) == ord('q'):
        loop = False
        cv2.destroyAllWindows()
        break

# =====================================================
# ۸. تشخیص چهره و چشم‌ها در حلقه while (نسخه نهایی)
# =====================================================
loop = True
while loop:
    _, img = cam.read()
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    face = face_model.detectMultiScale(gray)
    imgout = img.copy()

    if len(face) > 0:
        x = face[0][0]
        y = face[0][1]
        x2 = x + face[0][2]
        y2 = y + face[0][3]

        # رسم مستطیل دور چهره (سبز)
        cv2.rectangle(imgout, (x, y), (x2, y2), (0, 255, 0), 3)

        # برش ناحیه چهره برای تشخیص چشم
        gray_face = gray[y:y2, x:x2]
        eye = eye_model.detectMultiScale(gray_face)

        # رسم مستطیل دور چشم‌ها (قرمز)
        if len(eye) >= 2:
            xe = eye[0][0]
            ye = eye[0][1]
            x2e = xe + eye[0][2]
            y2e = ye + eye[0][3]

            xbe = eye[1][0]
            ybe = eye[1][1]
            x2be = xbe + eye[1][2]
            y2be = ybe + eye[1][3]

            cv2.rectangle(imgout, (x + xe, y + ye), (x + x2e, y + y2e), (0, 0, 250), 3)
            cv2.rectangle(imgout, (x + xbe, y + ybe), (x + x2be, y + y2be), (0, 0, 250), 3)

    cv2.imshow('fatemeh', imgout)

    if cv2.waitKey(1) == ord('q'):
        loop = False
        cv2.destroyAllWindows()
        break
